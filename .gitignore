# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# print agent / connector local
/print-agent/node_modules
/print-agent/data
/print-agent/dist/
/print-agent/runtime/node.exe
/print-agent/runtime/LICENSE
/print-agent/bin/*.exe
/print-agent/bin/*.dll
/print-agent/print-engine/
/print-agent/installer/staging/
/print-agent/installer/generated/

# typescript
*.tsbuildinfo
next-env.d.ts

# UltraPDV - backups locais
/backup-*/
/diagnostico-*/
/tef-*-temp/
/tef-menu-interativo-teste/

# Arquivos temporarios e pacotes de diagnostico
*.zip
*.bak
*.backup-*
*.backup-encoding

# Executaveis e bibliotecas compiladas
*.exe
*.dll
*.pfx
*.p12
*.key

# Lazarus - arquivos gerados
*.ppu
*.o
*.compiled
*.rst
/tef-agent/lib/
/tef-agent/backup/

# Journals e dados financeiros locais
tef-pendencia.json
tef-recuperacao.json
tef-vinculo.json
tef-pareamento.json

# Diagnosticos em texto na raiz
/diagnostico-*.txt
/comparacao-tef.txt


# Dados locais e runtime PayGoWeb
/print-agent/bin/tef/

# Artefatos locais de instalacao e comunicacao TEF
*.pos
TSTKEY.ini
assinatura.sig


# Dados locais PayGoWeb do agente Lazarus
/tef-agent/tef/

# Arquivos de sessao do Lazarus
*.lps

# Certificados e logs locais
*.crt
*.sig
