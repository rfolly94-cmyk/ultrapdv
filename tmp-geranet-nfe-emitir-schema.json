{
  "schema": {
    "type": "object",
    "description": "Payload de emissão. Os campos de IBS/CBS da NFe/NFCe ficam em cada item de nfe.itens. Para cobrança/pagamento a prazo, envie nfe.pagamento.detalhamento[].tipo, valor e indicadorPagamento, junto com nfe.fatura.numero, valor, desconto, valorLiquido e nfe.fatura.duplicatas[] com numero, dataVencimento, valor e, se desejar, codigoPagamento. No TEF, o detalhamento aceita cnpjCredenciadora, tipoBandeira, autorizacao, tipoIntegracao, cnpjPag, ufPag e cnpjReceb; os três últimos são opcionais e permanecem ausentes do XML quando não informados. Notas de crédito e débito são NFe modelo 55 e usam finalidade 5 ou 6. Em casos especiais, consulte x-detalhesCasosEspeciais para NFC-e offline.",
    "properties": {
      "nfe": {
        "type": "object",
        "properties": {
          "contingencia": {
            "type": "string",
            "enum": [
              "nao",
              "sim"
            ],
            "description": "Modo da NFC-e. Omita ou use nao para emissão normal; use sim somente para gerar NFC-e offline em contingência. Disponível para modelo 65.",
            "example": "nao"
          },
          "justificativaContingencia": {
            "type": "string",
            "maxLength": 256,
            "description": "Justificativa obrigatória quando nfe.contingencia = sim.",
            "example": "Indisponibilidade temporária de comunicação com a SEFAZ."
          },
          "finalidade": {
            "type": "string",
            "enum": [
              "1",
              "2",
              "3",
              "4",
              "5",
              "6"
            ],
            "description": "Finalidade da NFe: 1 normal, 2 complementar, 3 ajuste, 4 devolução, 5 nota de crédito e 6 nota de débito.",
            "example": "1"
          },
          "tipoNotaCredito": {
            "type": "string",
            "enum": [
              "01",
              "02",
              "03",
              "04",
              "05",
              "06"
            ],
            "description": "Obrigatório quando finalidade=5. 01 multa/juros; 02 crédito presumido; 03 retorno por recusa ou não localização; 04 redução de valores; 05 transferência por sucessão; 06 retorno por recusa parcial.",
            "example": "04"
          },
          "tipoNotaDebito": {
            "type": "string",
            "enum": [
              "01",
              "02",
              "03",
              "04",
              "05",
              "06",
              "07",
              "08"
            ],
            "description": "Obrigatório quando finalidade=6. 01 transferência de crédito de cooperativas; 02 anulação; 03 débitos não processados; 04 multa/juros; 05 transferência por sucessão; 06 pagamento antecipado; 07 perda em estoque; 08 desenquadramento do Simples Nacional.",
            "example": "06"
          },
          "indicadorPresenca": {
            "type": "string",
            "enum": [
              "0",
              "1",
              "2",
              "3",
              "4",
              "5",
              "9"
            ],
            "description": "Indicador de presença da operação: 0 não se aplica; 1 presencial; 2 internet; 3 teleatendimento; 4 entrega; 5 fora do estabelecimento; 9 outros.",
            "example": "1"
          },
          "indicativoIntermediador": {
            "type": "string",
            "enum": [
              "0",
              "1"
            ],
            "description": "Indicativo de intermediador: 0 sem intermediador; 1 com marketplace ou outro intermediador da operação.",
            "example": "0"
          },
          "notaFiscalReferencia": {
            "type": "string",
            "pattern": "^[0-9]{44}$",
            "description": "Chave de acesso da NFe referenciada, com 44 dígitos.",
            "example": "35260700000000000191550010000000011000000010"
          },
          "notasFiscaisPagamentoAntecipado": {
            "type": "array",
            "description": "Chaves de NFe relacionadas ao pagamento antecipado. Use em nota de débito.",
            "items": {
              "type": "string",
              "pattern": "^[0-9]{44}$"
            }
          },
          "pagamento": {
            "type": "object",
            "description": "Dados de pagamento. Os campos cnpjPag, ufPag e cnpjReceb são opcionais e não geram conteúdo no XML quando omitidos.",
            "properties": {
              "troco": {
                "type": "number",
                "description": "Valor do troco."
              },
              "detalhamento": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "tipo": {
                      "type": "string",
                      "description": "Forma de pagamento, como 03 cartão de crédito ou 04 cartão de débito.",
                      "example": "03"
                    },
                    "valor": {
                      "type": "number",
                      "description": "Valor pago.",
                      "example": 100
                    },
                    "indicadorPagamento": {
                      "type": "string",
                      "enum": [
                        "0",
                        "1"
                      ],
                      "description": "0 à vista; 1 a prazo.",
                      "example": "0"
                    },
                    "cnpjCredenciadora": {
                      "type": "string",
                      "description": "Opcional: CNPJ da credenciadora/adquirente do cartão.",
                      "example": "12345678000190"
                    },
                    "tipoBandeira": {
                      "type": "string",
                      "description": "Opcional: código da bandeira do cartão, como 01 Visa, 02 Mastercard, 06 Elo ou 99 outros.",
                      "example": "06"
                    },
                    "autorizacao": {
                      "type": "string",
                      "description": "Opcional: código de autorização da operação de cartão/TEF.",
                      "example": "123456"
                    },
                    "tipoIntegracao": {
                      "type": "string",
                      "enum": [
                        "1",
                        "2"
                      ],
                      "description": "Opcional: 1 pagamento integrado; 2 não integrado.",
                      "example": "1"
                    },
                    "cnpjPag": {
                      "type": "string",
                      "description": "Opcional: CNPJ do pagador, quando aplicável."
                    },
                    "ufPag": {
                      "type": "string",
                      "description": "Opcional: UF do pagador, quando aplicável.",
                      "example": "TO"
                    },
                    "cnpjReceb": {
                      "type": "string",
                      "description": "Opcional: CNPJ do recebedor do pagamento, quando aplicável."
                    }
                  },
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": true
          },
          "itens": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "cstIbscbs": {
                  "type": "string",
                  "description": "CST do IBS/CBS.",
                  "example": "000"
                },
                "cClassTribIbscbs": {
                  "type": "string",
                  "description": "Código de classificação tributária do IBS/CBS.",
                  "example": "000001"
                },
                "aliquotaIbsUf": {
                  "type": "string",
                  "description": "Alíquota do IBS estadual/UF.",
                  "example": "0.1000"
                },
                "aliquotaIbsMun": {
                  "type": "string",
                  "description": "Alíquota do IBS municipal.",
                  "example": "0.0000"
                },
                "aliquotaCbs": {
                  "type": "string",
                  "description": "Alíquota da CBS federal.",
                  "example": "0.9000"
                },
                "percentualReducaoIbsUf": {
                  "type": "string",
                  "description": "Percentual de redução da alíquota do IBS estadual/UF, de 0 a 100. Quando maior que zero, gera gRed.pRedAliq e calcula pAliqEfet.",
                  "example": "0.00"
                },
                "percentualReducaoIbsMun": {
                  "type": "string",
                  "description": "Percentual de redução da alíquota do IBS municipal, de 0 a 100. Quando maior que zero, gera gRed.pRedAliq e calcula pAliqEfet.",
                  "example": "0.00"
                },
                "percentualReducaoCbs": {
                  "type": "string",
                  "description": "Percentual de redução da alíquota da CBS, de 0 a 100. Quando maior que zero, gera gRed.pRedAliq e calcula pAliqEfet.",
                  "example": "0.00"
                },
                "baseCalculoIbscbs": {
                  "type": "string",
                  "description": "Base de cálculo do IBS/CBS no item. Quando omitida, é usado o valor total do produto.",
                  "example": "20.00"
                },
                "valorIbsUf": {
                  "type": "string",
                  "description": "Valor do IBS estadual/UF. Quando omitido, é calculado pela base e aliquotaIbsUf.",
                  "example": "0.02"
                },
                "valorIbsMun": {
                  "type": "string",
                  "description": "Valor do IBS municipal. Quando omitido, é calculado pela base e aliquotaIbsMun.",
                  "example": "0.00"
                },
                "valorCbs": {
                  "type": "string",
                  "description": "Valor da CBS. Quando omitido, é calculado pela base e aliquotaCbs.",
                  "example": "0.18"
                },
                "ibscbsManual": {
                  "type": "string",
                  "description": "Use \"1\" para informar manualmente os campos de IBS/CBS do item; use \"0\" para seguir o cálculo/regra padrão do emissor.",
                  "example": "0"
                },
                "documentoFiscalReferenciado": {
                  "type": "object",
                  "description": "Documento fiscal vinculado especificamente ao item.",
                  "properties": {
                    "chaveAcesso": {
                      "type": "string",
                      "pattern": "^[0-9]{44}$",
                      "description": "Chave de acesso do documento fiscal, com 44 dígitos."
                    },
                    "numeroItem": {
                      "type": "integer",
                      "minimum": 1,
                      "description": "Número do item referenciado no documento fiscal."
                    }
                  }
                }
              },
              "additionalProperties": true
            }
          }
        }
      }
    },
    "additionalProperties": true
  },
